{
  "manifest_version": 3,
  "name": "ManyKee",
  "version": "0.1.0",
  "description": "KeePass vault browser - KDBX 4.x password manager",

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "permissions": [
    "storage",
    "sidePanel",
    "downloads"
  ],

  "action": {
    "default_title": "ManyKee"
  },

  "background": {
    "service_worker": "background.js"
  },

  "side_panel": {
    "default_path": "index.html"
  },

  "web_accessible_resources": [{
    "resources": ["*.wasm", "*.js"],
    "matches": ["<all_urls>"]
  }]
}
