{
  "manifest_version": 3,
  "name": "ManyKee",
  "version": "0.1.0",
  "description": "KeePass vault browser - KDBX 4.x password manager",

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },

  "permissions": [
    "sidePanel"
  ],

  "action": {
    "default_title": "ManyKee"
  },

  "background": {
    "service_worker": "background.js"
  },

  "side_panel": {
    "default_path": "index.html"
  }
}
